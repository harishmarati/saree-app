PORT=4000

# Comma-separated list of allowed frontend origins (e.g. your Vercel URL).
# Leave unset to allow all origins (fine for local dev).
CORS_ORIGIN=

# Leave both unset to use a local SQLite file (./saree.db) for local dev.
# Set both to point at a Turso database for production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required. The single shared password for logging into the app.
ADMIN_PASSWORD=

# Required. Random secret used to sign login session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
