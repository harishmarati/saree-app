# Leave unset for local dev (uses the Vite proxy to localhost:4000).
# Set to your deployed Render backend URL in production (e.g. on Vercel),
# with no trailing slash, e.g. https://saree-app-backend.onrender.com
VITE_API_BASE_URL=

# Cloudinary unsigned upload (free tier). Create an account at cloudinary.com,
# find your cloud name on the dashboard, and create an "unsigned" upload preset
# under Settings > Upload. Both are safe to expose in frontend code.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
